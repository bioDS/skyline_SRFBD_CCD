<beast version='2.0'
       namespace='beast.pkgmgmt
       :beast.base.core
       :beast.base.inference
       :beast.base.evolution.tree.coalescent
       :beast.base.evolution.sitemodel
       :beast.base.evolution.tree
       :beast.pkgmgmt
       :beast.base.core
       :beast.base.inference.util:beast.evolution.nuc:beast.base.evolution.operator:beast.base.inference.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.likelihood:beast.base.evolution.alignment
       :sr.evolution.operators
       :sa.evolution.operators
       :sr.evolution.tree
       :sr.evolution.sranges
       :sr.speciation
       :feast.parameter
       :ssr.speciation'>

           <data id='morph_alignment' spec='beast.base.evolution.alignment.Alignment'>
    <sequence id='morph' spec='beast.base.evolution.alignment.Sequence' taxon='t5_last' value='31130233513203126311531233543166430611402400564326210550642563442342533313606445254611111251661666503634420650640651142522565552153054344165136362360244462526612645515266013300036222451202516603335225'/>

    <sequence id='morph1' spec='beast.base.evolution.alignment.Sequence' taxon='t10_first' value='31130233513203126311531233543166330611402000564326210550642563442342533353606445254611111251661666533634420650640641142522565552153054344165136332360244462526612645515266013300036222451202516603335223'/>

    <sequence id='morph2' spec='beast.base.evolution.alignment.Sequence' taxon='t11_first' value='31130233513203126311531233543166330611402000564326210550642563442342533313606445254611111251661666503634420650640641542522565552153054344165136332360244462526612645515266013300036222451202516603335223'/>

    <sequence id='morph3' spec='beast.base.evolution.alignment.Sequence' taxon='t15_first' value='31130233513203126311531233543166430611402400564326210550632563442342533313606445454611121251661666543634420650640651142522565552153054344165136362360244462526612645515266013300036222451202516603335225'/>

    <sequence id='morph4' spec='beast.base.evolution.alignment.Sequence' taxon='t8_first' value='31130233513203126311531233543166430611402400564326210550642563442342533313606445254611131251661666543634420650640151142522565552153054344165136562360244462526612645515266013300036222451202516603335225'/>

    <sequence id='morph5' spec='beast.base.evolution.alignment.Sequence' taxon='t18_first' value='31130233513203126311531233543166430611402400564326210550642563442342533313606445254611131251661666543634420650640651142522565552153054344165136562360244462526612645515266013300036222451202516603335225'/>

    <sequence id='morph6' spec='beast.base.evolution.alignment.Sequence' taxon='t5_first' value='31130233513203126311531233543166430611402400564326210550642563442342533313606445254611111251661666503634420650640651142522565552153054344165136362360244462526612645515266013300036222451202516603334225'/>

    <input id='morphDataType' spec='beast.base.evolution.datatype.StandardData' name='userDataType' nrOfStates='7'/>

</data>


    <siteModel id="morphSiteModel" spec="SiteModel" gammaCategoryCount="1">
        <substModel id="LewisMK" spec="morphmodels.evolution.substitutionmodel.LewisMK" datatype="@morphDataType"/>
    </siteModel>

<branchRateModel id="StrictClock_morph" spec="beast.base.evolution.branchratemodel.StrictClockModel"
                 clock.rate="@clockRate_morph"/>




    <data id='dna_alignment' spec='beast.base.evolution.alignment.Alignment'>
    <sequence spec='beast.base.evolution.alignment.Sequence' taxon='t5_last' value='----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------'/>

    <sequence id='dna1' spec='beast.base.evolution.alignment.Sequence' taxon='t10_first' value=''/>

    <sequence id='dna2' spec='beast.base.evolution.alignment.Sequence' taxon='t11_first' value=''/>

    <sequence id='dna3' spec='beast.base.evolution.alignment.Sequence' taxon='t15_first' value=''/>

    <sequence id='dna4' spec='beast.base.evolution.alignment.Sequence' taxon='t8_first' value=''/>

    <sequence id='dna5' spec='beast.base.evolution.alignment.Sequence' taxon='t18_first' value=''/>

    <sequence spec='beast.base.evolution.alignment.Sequence' taxon='t5_first' value='----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------'/>

    <input id='Nucleotide' spec='beast.base.evolution.datatype.Nucleotide' name='userDataType'/>

</data>


    <siteModel spec='SiteModel' id="siteModel_dna" gammaCategoryCount='1'>
        <substModel spec='JukesCantor' id='JC69'/>
    </siteModel>

<branchRateModel id="StrictClock_dna" spec="beast.base.evolution.branchratemodel.StrictClockModel"
                 clock.rate="@clockRate_dna"/>

    <map name="Uniform">beast.base.inference.distribution.Uniform</map>
    <map name="Exponential">beast.base.inference.distribution.Exponential</map>
    <map name="LogNormal">beast.base.inference.distribution.LogNormalDistributionModel</map>
    <map name="Normal">beast.base.inference.distribution.Normal</map>
    <map name="Beta">beast.base.inference.distribution.Beta</map>
    <map name="Gamma">beast.base.inference.distribution.Gamma</map>
    <map name="LaplaceDistribution">beast.base.inference.distribution.LaplaceDistribution</map>
    <map name="prior">beast.base.inference.distribution.Prior</map>
    <map name="InverseGamma">beast.base.inference.distribution.InverseGamma</map>
    <map name="OneOnX">beast.base.inference.distribution.OneOnX</map>


    <run spec="MCMC" id="mcmc" chainLength="20000000"> 

        <state id="state" storeEvery="10000">
            <tree id="tree" spec="sr.evolution.tree.SRTree" nodetype="sr.evolution.tree.SRNode" name="stateNode">
                <trait id="dateTrait.t:tree" spec="beast.base.evolution.tree.TraitSet" traitname="date-backward">
                    <taxa spec="TaxonSet" id="taxonSet">
                        <taxon spec='Taxon' id='t5_first'/>
						<taxon spec='Taxon' id='t5_last'/>
						<taxon spec='Taxon' id='t10_first'/>
						<taxon spec='Taxon' id='t11_first'/>
						<taxon spec='Taxon' id='t15_first'/>
						<taxon spec='Taxon' id='t8_first'/>
						<taxon spec='Taxon' id='t18_first'/>
                    </taxa>
                    t5_first=3.39901553019611, t5_last=1.36836935789324, t10_first=0, t11_first=0, t15_first=0, t8_first=0, t18_first=0
                </trait>
                <taxonset idref="taxonSet" />
                <stratigraphicRange id="r0" spec="StratigraphicRange" firstOccurrence="@t5_first" lastOccurrence="@t5_last"/>
				<stratigraphicRange id="r1" spec="StratigraphicRange" firstOccurrence="@t10_first" lastOccurrence="@t10_first"/>
				<stratigraphicRange id="r2" spec="StratigraphicRange" firstOccurrence="@t11_first" lastOccurrence="@t11_first"/>
				<stratigraphicRange id="r3" spec="StratigraphicRange" firstOccurrence="@t15_first" lastOccurrence="@t15_first"/>
				<stratigraphicRange id="r4" spec="StratigraphicRange" firstOccurrence="@t8_first" lastOccurrence="@t8_first"/>
				<stratigraphicRange id="r5" spec="StratigraphicRange" firstOccurrence="@t18_first" lastOccurrence="@t18_first"/>
            </tree>
            <parameter id='netDiversification' lower='0.0'
                                name='stateNode'>0.73315312936902 0.821208916977048 0.74659389522858 0.716597643960267</parameter>
            <parameter id='turnOver' lower='0.' upper = '1.'
                                name='stateNode'>0.4188300490845 0.56953539098613 0.775501219183207 0.759546816069633</parameter>
            <parameter id='samplingProportion' lower='0.0'
                                name='stateNode'>0.533323148312047 0.530929229408503 0.36430544750765 0.799872761173174</parameter>
            <parameter id='rho' lower='0.0'
                                name='stateNode'>0.877247659070417</parameter>
            <parameter id="clockRate_dna" spec="parameter.RealParameter" name="stateNode" lower="0.0">0.01</parameter>
            <parameter id="clockRate_morph" spec="parameter.RealParameter" name="stateNode" lower="0.0">0.01</parameter>
        </state>

        <init estimate="false" id="Randomtree" initial="@tree" spec="RandomSRangeTree" nodetype="sr.evolution.tree.SRNode" taxonset="@taxonSet">
            <populationModel id="ConstantPopulation0.t" spec="ConstantPopulation">
            <parameter id="randomPopSize.t" name="popSize">0.01</parameter>
            </populationModel>
            <stratigraphicRange idref="r0"/>
			<stratigraphicRange idref="r1"/>
			<stratigraphicRange idref="r2"/>
			<stratigraphicRange idref="r3"/>
			<stratigraphicRange idref="r4"/>
			<stratigraphicRange idref="r5"/>
        </init>

        <init id="netDiversificationInitializer" spec="feast.parameter.RandomRealParameter"
              initial="@netDiversification" distr="@Uniform.div">
        </init>
        <init id="turnoverInitializer" spec="feast.parameter.RandomRealParameter"
              initial="@turnOver" distr="@Uniform.turnover">
        </init>
        <init id="samplingProportionInitializer" spec="feast.parameter.RandomRealParameter"
              initial="@samplingProportion" distr="@Uniform.samplingProportion">
        </init>

        <init id="clockRateInitializer_dna" spec="feast.parameter.RandomRealParameter"
      initial="@clockRate_dna" distr="@Exponential.clockRate_dna"/>
        <init id="clockRateInitializer_morph" spec="feast.parameter.RandomRealParameter"
      initial="@clockRate_morph" distr="@Exponential.clockRate_morph"/>

        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution spec="SRangesBirthDeathSkylineModel" id="birthDeath" tree="@tree" conditionOnRhoSampling="true" conditionOnSurvival="false" contemp="true" removalProbability="0.0 0.0 0.0 0.0" intervalTimes="0 1 2 3">
                    <parameter id="origin" spec="parameter.RealParameter" name="origin" estimate="false">4.0</parameter>
                    <netDiversification idref="netDiversification"/>
                    <turnOver idref="turnOver"/>
                    <samplingProportion idref="samplingProportion"/>
                    <rho idref="rho"/>
                </distribution>
                <!-- <prior id="originPrior" name="distribution" x="@origin">
                    <Uniform id="Uniform.origin" name="distr" lower="1" upper="8"/>
                </prior> -->
                <prior id="netDiversificationPrior" name="distribution" x="@netDiversification">
                    <Uniform id="Uniform.div" name="distr" lower="0.7" upper="0.9" offset="0."/>
                </prior>
                <prior id="turnoverPrior" name="distribution" x="@turnOver">
                    <Uniform id="Uniform.turnover" name="distr" lower="0.2" upper="0.8" offset="0."/>
                </prior>
                <prior id="samplingProportionPrior" name="distribution" x="@samplingProportion">
                    <Uniform id="Uniform.samplingProportion" name="distr" lower="0.2" upper="0.8" offset="0."/>
                </prior>
                <prior id="rhoPrior" name="distribution" x="@rho">
                    <Uniform id="Uniform.rho" lower="0.7" upper="1." name="distr"/>
                </prior>
                <prior id="clockRatePrior_dna" name="distribution" x="@clockRate_dna">
                    <Exponential id="Exponential.clockRate_dna" name="distr">
                        <parameter id="expMean.clockRate_dna" spec="parameter.RealParameter"
                                estimate="false" name="mean">0.01</parameter>
                    </Exponential>
                </prior>
                <prior id="clockRatePrior_morph" name="distribution" x="@clockRate_morph">
                    <Exponential id="Exponential.clockRate_morph" name="distr">
                        <parameter id="expMean.clockRate_morph" spec="parameter.RealParameter"
                                estimate="false" name="mean">0.01</parameter>
                    </Exponential>
                </prior>
</distribution>

            <distribution id="dnaTreeLikelihood" spec="TreeLikelihood" useAmbiguities="true" tree="@tree">
                <data idref="dna_alignment"/>
                <siteModel idref="siteModel_dna"/>
                <branchRateModel idref="StrictClock_dna"/>
            </distribution>

            <distribution id="morphTreeLikelihood" spec="TreeLikelihood" useAmbiguities="true" tree="@tree">
                <data idref="morph_alignment"/>
                <siteModel idref="morphSiteModel"/>
                <branchRateModel idref="StrictClock_morph"/>
            </distribution>
        </distribution>


<!--        Parameter operators -->
        <!-- <operator id="originScaler" parameter="@origin" scaleFactor="0.75" spec="ScaleOperator" weight="1.0"/> -->
        <operator id='netDiversificatonOperator' spec='ScaleOperator' scaleFactor=".75" weight="5" parameter="@netDiversification"/>
        <operator id='turnOverOperator' spec='ScaleOperator' scaleFactor=".75" weight="5" parameter="@turnOver"/>
        <operator id='samplingProportionOperator' spec='ScaleOperator' scaleFactor=".75" weight="5" parameter="@samplingProportion"/>
        <operator id='rhoOperator' spec='ScaleOperator' scaleFactor=".75" weight="5" parameter="@rho"/>

        <operator id="clockRateScaler_dna" spec="ScaleOperator" scaleFactor="0.75" weight="3" parameter="@clockRate_dna"/>
        <operator id="clockRateScaler_morph" spec="ScaleOperator" scaleFactor="0.75" weight="3" parameter="@clockRate_morph"/>

<!--        Tree operators -->
        <operator id="SRWilsonBalding" spec='SRWilsonBalding' weight="20" tree="@tree"/>
        <operator id="LeftRightChildSwap" spec='LeftRightChildSwap' weight="5" tree="@tree"/>
        <operator id="LeafToSampledAncestorJump" spec='SRLeafToSampledAncestorJump' weight="20" tree="@tree" />
        <operator spec="SAUniform" weight="20" tree="@tree"/>
        <operator id="SATreeRootScaler" rootOnly="true" scaleFactor="0.56" spec="SAScaleOperator" tree="@tree" weight="3.0" />
        <operator id='treeScaler' spec="SAScaleOperator" scaleFactor="0.16" weight="10.0" tree="@tree"/>


        <logger id="tracelog" spec="Logger" fileName="/home/ket581/skyline/SUMMER/skyline-SRFBD-validation/runs/run_20/inf/187/sRanges.$(seed).log" logEvery="10000">
            <model idref='posterior'/>

            <log id="TreeHeight" spec="TreeHeightLogger" tree="@tree"/>
            <log idref="origin"/>
            <log idref="netDiversification"/>
            <log idref="turnOver"/>
            <log idref="samplingProportion"/>
            <log idref="rho"/>
            <log idref="posterior"/>
            <log idref="clockRate_dna"/>
            <log idref="clockRate_morph"/>
        </logger>
        <logger id="treelog" spec="Logger" fileName="/home/ket581/skyline/SUMMER/skyline-SRFBD-validation/runs/run_20/inf/187/sRanges.$(seed).trees" logEvery="10000" mode="tree">
            <log id="TreeWithMetaDataLogger.t:tree" spec="sr.evolution.tree.TreeWithMetadataLogger" branchratemodel="@StrictClock_dna" tree="@tree"/>
        </logger>
    </run>
        
        
        </beast>

                <taxonset idref="taxonSet" />
                <stratigraphicRange id="r0" spec="StratigraphicRange" firstOccurrence="@t4_first" lastOccurrence="@t4_first"/>
				<stratigraphicRange id="r1" spec="StratigraphicRange" firstOccurrence="@t1_first" lastOccurrence="@t1_last"/>
				<stratigraphicRange id="r2" spec="StratigraphicRange" firstOccurrence="@t6_first" lastOccurrence="@t6_last"/>
				<stratigraphicRange id="r3" spec="StratigraphicRange" firstOccurrence="@t7_first" lastOccurrence="@t7_first"/>
				<stratigraphicRange id="r4" spec="StratigraphicRange" firstOccurrence="@t2_first" lastOccurrence="@t2_first"/>
				<stratigraphicRange id="r5" spec="StratigraphicRange" firstOccurrence="@t9_first" lastOccurrence="@t9_first"/>
				<stratigraphicRange id="r6" spec="StratigraphicRange" firstOccurrence="@t10_first" lastOccurrence="@t10_first"/>
				<stratigraphicRange id="r7" spec="StratigraphicRange" firstOccurrence="@t13_first" lastOccurrence="@t13_first"/>
